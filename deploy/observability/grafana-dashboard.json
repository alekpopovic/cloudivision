{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "BuildRuns by phase (status update rate)",
      "description": "Transitions/status updates per phase; this is not a current object count.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(cloudivision_buildrun_total[$__rate_interval])) by (phase)", "legendFormat": "{{phase}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "BuildRun success rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(cloudivision_buildrun_total{phase=\"Succeeded\"}[$__rate_interval])) / clamp_min(sum(rate(cloudivision_buildrun_total{phase=~\"Succeeded|Failed\"}[$__rate_interval])), 0.001)", "legendFormat": "success", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Build duration p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(cloudivision_buildrun_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(cloudivision_buildrun_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(cloudivision_buildrun_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Build queue time p95",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(cloudivision_buildrun_queue_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Runner Job failures",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(increase(cloudivision_runner_job_failures_total[$__rate_interval]))", "legendFormat": "failures", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Runner image pull failures",
      "description": "Requires kube-state-metrics pod and label metrics.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(kube_pod_container_status_waiting_reason{reason=~\"ErrImagePull|ImagePullBackOff\"} * on(namespace,pod) group_left() kube_pod_labels{label_app_kubernetes_io_component=\"runner\"})", "legendFormat": "waiting pods", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Controller reconcile error rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(cloudivision_reconcile_errors_total[$__rate_interval])) by (controller)", "legendFormat": "{{controller}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Controller reconcile duration p95",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(cloudivision_reconcile_duration_seconds_bucket[$__rate_interval])) by (le, controller))", "legendFormat": "{{controller}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "API request rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(cloudivision_http_requests_total[$__rate_interval])) by (method, route)", "legendFormat": "{{method}} {{route}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "API latency p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(cloudivision_http_request_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum(rate(cloudivision_http_request_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "API 5xx rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(cloudivision_http_requests_total{status=~\"5..\"}[$__rate_interval])) by (route)", "legendFormat": "{{route}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Webhook outcomes",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(increase(cloudivision_webhook_events_total[$__rate_interval])) by (provider, outcome)", "legendFormat": "{{provider}} {{outcome}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Release phase distribution (status update rate)",
      "description": "Transitions/status updates per phase; this is not a current object count.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(cloudivision_release_status_updates_total[$__rate_interval])) by (phase)", "legendFormat": "{{phase}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 21 }
    },
    {
      "type": "timeseries",
      "title": "GitOps failures",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(increase(cloudivision_gitops_failures_total[$__rate_interval])) by (operation)", "legendFormat": "{{operation}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 21 }
    },
    {
      "type": "timeseries",
      "title": "Release deployment duration p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(cloudivision_release_deployment_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(cloudivision_release_deployment_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(cloudivision_release_deployment_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 21 }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL audit write failures",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(increase(cloudivision_audit_write_failures_total[$__rate_interval]))", "legendFormat": "write failures", "refId": "A" }],
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 21 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cloudivision", "cicd", "kubernetes"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "cloudivision Operations",
  "uid": "cloudivision-operations",
  "version": 1
}
