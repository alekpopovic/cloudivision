---
layout: null
permalink: /search.json
---
[
{% assign searchable_pages = site.pages | where_exp: "item", "item.path contains '.md'" %}
{% for item in searchable_pages %}
  {
    "title": {{ item.title | default: item.basename | replace: '-', ' ' | capitalize | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "content": {{ item.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
